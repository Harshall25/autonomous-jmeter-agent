# ---------------------------------------------------------------------------
# Autonomous JMeter Agent — environment template
#
#   cp .env.example .env    and fill in the two REQUIRED values.
#
# IMPORTANT: `java -jar` does NOT read a .env file. Only Docker Compose does.
# To use this file with a plain JVM, source it into the environment first:
#
#     set -a; . ./.env; set +a
#     java -jar target/autonomous-jmeter-agent-1.0.0-SNAPSHOT.jar --mode=API --source=x.har
#
# Every setting here has a working default except the two marked REQUIRED.
# Anything in application.yml can also be overridden as an env var using Spring's
# relaxed binding (agent.jmeter.max-retries -> AGENT_JMETER_MAXRETRIES).
# ---------------------------------------------------------------------------

# === REQUIRED ==============================================================

# Your Anthropic API key. Get one at https://console.anthropic.com/settings/keys
# The agent makes 1 model call to generate a plan, plus 1 per self-healing turn.
ANTHROPIC_API_KEY=sk-ant-api03-REPLACE_ME

# JMeter's bin directory — the folder containing the `jmeter` launcher script.
# Download: https://jmeter.apache.org/download_jmeter.cgi (5.6.3 or newer)
#   macOS/Linux tarball ->  /opt/apache-jmeter-5.6.3/bin
#   Homebrew            ->  /opt/homebrew/bin
#   Docker image below  ->  /opt/apache-jmeter/bin
JMETER_HOME=/opt/apache-jmeter/bin


# === MODEL =================================================================

# Which Claude model answers the agent's turns.
#
# READ THIS BEFORE CHANGING IT. Spring AI 1.0.0 always sends `temperature` on
# every request, and Claude 5 models reject that parameter with HTTP 400. So
# claude-opus-5 and claude-sonnet-5 CANNOT be used until Spring AI is upgraded
# — setting them here makes every run fail with "400 invalid_request_error".
# See docs/DEPLOYMENT.md § Known limitations.
#
# Works today: claude-haiku-4-5  ($1/MTok in, $5/MTok out, 200K context)
ANTHROPIC_MODEL=claude-haiku-4-5

# Cap on tokens the model may produce per turn. A generated plan is long; too
# low truncates it into an unusable plan. Stay under ~32000 on a non-streaming
# client or requests start hitting the HTTP timeout.
ANTHROPIC_MAX_TOKENS=16000


# === WORKSPACE =============================================================

# Where generated plans, test data, results and audit files are written.
# Must be writable. In Docker, mount a volume here or artifacts vanish with
# the container.
AGENT_WORKSPACE=/var/lib/jmeter-agent/workspace


# === CI PERFORMANCE GATE (optional) ========================================

# Off by default, so adding the agent to a pipeline never silently starts
# failing builds. Turn on to block a merge on a performance regression.
# A breach exits 2; a crash exits 1; success exits 0.
AGENT_GATE_ENABLED=false


# === MULTI-TENANCY AND PROVENANCE (optional) ===============================

# Off by default. One operator on one machine needs none of this.
AGENT_TENANCY_ENABLED=false

# Which tenant this process runs for. Lowercase letters, digits and hyphens,
# 1-63 characters. Each tenant gets its own workspace subdirectory.
AGENT_TENANT=local

# Secret that signs run manifests, making the audit trail tamper-evident.
# MUST be at least 32 characters. Generate one with:
#     openssl rand -hex 32
# Leave empty and the agent REFUSES to sign rather than recording a signature
# that proves nothing. Never commit a real value — keep it in your secret store.
AGENT_SIGNING_KEY=

# Free-text label recorded in every run manifest, so a plan can be traced back
# to the prompt revision that produced it. A git SHA or release tag works well.
AGENT_PROMPT_REVISION=
